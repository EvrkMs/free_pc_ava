# Логин/пароль для автоматического повторного входа, когда сессия
# (.session/cookies.txt) протухает. Без них при протухшей сессии сервер
# просто логирует ошибку и ждёт ручного "node login.js".
LANGAME_LOGIN=
LANGAME_PASSWORD=

# Публичный виджет на Cloudflare Worker (см. worker/) сам стучится сюда через
# Cloudflare VPC-туннель (ru-ava.local:3000) — этому серверу самому наружу
# ничего слать не нужно, никаких переменных для этого не требуется.

# Ниже — не обязательно, есть разумные значения по умолчанию.
# LANGAME_BASE_URL=https://226.langame.ru
# LANGAME_CERT_REF=CurrentUser\MY\<отпечаток>
# LANGAME_CERT_ISSUER=langame.ru
# LANGAME_LANG=ru
# LANGAME_TIMEOUT=30
