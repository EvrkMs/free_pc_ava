# Логин/пароль для автоматического повторного входа, когда сессия
# (.session/cookies.json) протухает. Без них при протухшей сессии сервер
# просто логирует ошибку и ждёт ручного "node login.js".
LANGAME_LOGIN=
LANGAME_PASSWORD=

# Пароль от клиентского сертификата secrets/langame.p12 (пусто, если
# сертификат без пароля). Сам путь к файлу задаётся LANGAME_PFX_PATH и по
# умолчанию указывает на secrets/langame.p12 — см. DOCKER.md.
LANGAME_PFX_PASSPHRASE=

# Standalone серверный API-ключ (публичный API, без mTLS-сертификата).
# Заголовок: X-Request-Token: {LANGAME_API_KEY}
# Нужен для категорий/зон ПК:
#   GET /public_api/global/linking_pc_by_type/list
#   GET /public_api/global/types_of_pc_in_clubs/list
# Без ключа зоны берутся из HTML (хрупко) или остаются пустыми → «Другое».
LANGAME_API_KEY=

# Имя docker-сети, в которой работает caddy-docker-proxy (по умолчанию caddy).
# CADDY_NETWORK=caddy

# Адрес панели клуба, например https://<номер>.langame.ru (обязательно).
LANGAME_BASE_URL=

# Ниже — не обязательно, есть разумные значения по умолчанию.
# Сертификат: имя файла в ./secrets (client_id2250.p12) или путь к нему.
# LANGAME_PFX_PATH=./secrets/langame.p12
# LANGAME_LANG=ru
# LANGAME_TIMEOUT=30
